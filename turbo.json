{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "gen": {
      "inputs": ["../../icons/**", "scripts/**", "*.config.*"],
      "outputs": ["src/**", "metadata.json"]
    },
    "build": {
      "dependsOn": ["gen", "^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
